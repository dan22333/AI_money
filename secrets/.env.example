# Copy to secrets/.env and fill in. NEVER commit secrets/.env (it's gitignored).
# In production these come from GCP Secret Manager, not this file.

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=x-ai/grok-4.3
MODE_MODEL=mistralai/mistral-nemo

# --- Fanvue OAuth app ---
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_SCOPES="read:self read:chat write:chat offline_access"
OAUTH_REDIRECT_URI=http://localhost:8080/callback
OAUTH_ISSUER_BASE_URL=https://auth.fanvue.com
API_BASE_URL=https://api.fanvue.com

# --- Fanvue webhooks (set after GCP deploy) ---
FANVUE_WEBHOOK_SECRET=

# --- Test/admin endpoint guard ---
SIM_SECRET=

# --- GCP ---
GCP_PROJECT=capsule-487202
USE_FIRESTORE=false
